{
  "name": "cstar-lang",
  "displayName": "cstar Language",
  "description": "Syntax highlighting, snippets, autocomplete, and live error diagnostics for the cstar programming language (.cst; legacy .pen / .pent until v0.4)",
  "version": "0.2.1",
  "publisher": "cstar-lang",
  "license": "MIT",
  "keywords": [
    "cstar",
    "control flow",
    "syntax highlighting",
    "autocomplete",
    "snippets",
    "diagnostics"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "scripts": {
    "test": "node test/smoke.js",
    "smoke": "node test/smoke.js"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:cstar"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cstar",
        "aliases": [
          "cstar"
        ],
        "extensions": [
          ".cst",
          ".pen",
          ".pent"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cstar",
        "scopeName": "source.cstar",
        "path": "./syntaxes/cstar.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cstar",
        "path": "./snippets/cstar.json"
      }
    ],
    "commands": [
      {
        "command": "cstar.run",
        "title": "Run File",
        "category": "cstar",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cstar.run",
          "when": "resourceLangId == cstar",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "cstar.run",
          "when": "resourceLangId == cstar",
          "group": "cstar@1"
        }
      ],
      "commandPalette": [
        {
          "command": "cstar.run",
          "when": "editorLangId == cstar || resourceLangId == cstar"
        }
      ]
    },
    "configurationDefaults": {
      "[cstar]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.tabCompletion": "on",
        "editor.autoIndent": "full",
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggest.showWords": true
      }
    },
    "configuration": {
      "title": "cstar",
      "properties": {
        "cstar.executable": {
          "type": "string",
          "default": "cstar",
          "scope": "machine",
          "description": "Path to the cstar CLI used for live diagnostics and Run. The default 'cstar' searches PATH, ~/.local/bin, and common install locations, then falls back to the legacy 'pentest' command."
        },
        "cstar.diagnostics": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show syntax and semantic errors while typing. Runs 'cstar check' only — code is never compiled or executed."
        },
        "cstar.diagnosticsDelay": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "scope": "resource",
          "description": "Milliseconds to wait after typing before re-checking the document."
        },
        "pentest.executable": {
          "type": "string",
          "default": "cstar",
          "scope": "machine",
          "deprecationMessage": "Renamed to 'cstar.executable' (still read until v0.4 when cstar.executable is not set).",
          "description": "Legacy name of cstar.executable."
        },
        "pentest.diagnostics": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "deprecationMessage": "Renamed to 'cstar.diagnostics' (still read until v0.4 when cstar.diagnostics is not set).",
          "description": "Legacy name of cstar.diagnostics."
        },
        "pentest.diagnosticsDelay": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "scope": "resource",
          "deprecationMessage": "Renamed to 'cstar.diagnosticsDelay' (still read until v0.4 when cstar.diagnosticsDelay is not set).",
          "description": "Legacy name of cstar.diagnosticsDelay."
        }
      }
    }
  }
}
