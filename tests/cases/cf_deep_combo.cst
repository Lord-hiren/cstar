s = 0
for a in range(0, 2):
    if a == 0:
        for b in range(0, 2):
            while True:
                switch b:
                    case 0:
                        s += 1
                        break
                    case *:
                        s += 10
                        break
                break
    else:
        s += 100
print(s)
print("done")
