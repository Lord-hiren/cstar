# bi_py_numeric_errors — abs/divmod/pow/round failure shapes (Python
# wording; Pentest's documented int-only modulo rules where they differ).
try:
    abs("x")
except TypeError as e:
    print("1", e.message)
try:
    abs(None)
except TypeError as e:
    print("2", e.message)
try:
    divmod(1.5, 2)
except TypeError as e:
    print("3", e.message)
try:
    divmod(5, 0)
except ZeroDivisionError as e:
    print("4", e.message)
try:
    pow(2, -1)
except ValueError as e:
    print("5", e.message)
try:
    pow("a", 2)
except TypeError as e:
    print("6", e.message)
try:
    pow(3, 4, 0)
except ValueError as e:
    print("7", e.message)
try:
    pow(3, 4, -5)
except ValueError as e:
    print("8", e.message)
try:
    pow(3, -2, 7)
except ValueError as e:
    print("9", e.message)
try:
    pow(1.5, 2, 3)
except TypeError as e:
    print("10", e.message)
try:
    round(1.5, "x")
except TypeError as e:
    print("11", e.message)
try:
    round("x")
except TypeError as e:
    print("12", e.message)
print("13 done")
