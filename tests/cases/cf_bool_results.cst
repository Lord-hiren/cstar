print(True and 5)
print(5 and True)
print(0 and 5)
print(5 and 0)
print(1 and 2 and 3)
print("" and "x")
print("x" and "")
print(None and 1)
print(1 or 2)
print(0 or 5)
print(0 or 0)
print("" or None)
print("x" or None)
print(2.5 or 0)
print(0.0 or 2.5)
print(range(0, 1) and 9)
print(range(1, 1) or 9)
