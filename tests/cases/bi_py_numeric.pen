# bi_py_numeric — abs / divmod / pow / round (SPEC §5.11.5), happy paths.
# Cross-checked against CPython; Pentest deviations (int64 wrap, C99 divmod,
# int-only modulo) are the documented ones.
print(abs(-5))
print(abs(5))
print(abs(-2.5))
print(abs(0))
print(divmod(7, 3))
print(divmod(-7, 3))
print(divmod(7, -3))
print(divmod(-7, -3))
print(divmod(0, 5))
print(divmod(9223372036854775807, -1))
print(pow(2, 10))
print(pow(2, 0))
print(pow(0, 0))
print(pow(-2, 3))
print(pow(2.0, 3))
print(pow(2, 3.0))
print(pow(2.0, 0.5))
print(pow(3, 4, 5))
print(pow(0, 5, 7))
print(pow(123456789, 987654321, 1000000007))
print(round(2.5))
print(round(3.5))
print(round(0.5))
print(round(1.5))
print(round(2.4))
print(round(-2.5))
print(round(-0.5))
print(round(7))
print(round(2.675, 2))
print(round(3.14159, 3))
print(round(1234.5678, -2))
print(round(5, -1))
print(round(15, -1))
print(round(25, -1))
print(round(5, 0))
print(round(-1.5))
print(round(1.0))
# one-arg int is the identity, any non-negative ndigits too
print(round(42, 0))
print(round(42, 3))
