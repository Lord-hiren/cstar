# rng_edges — parity pin for range edges (SPEC §6.9, §5.5, §6.6):
# descending/exclusive bounds, empty ranges (display, membership and
# loop-var assigned-ness), int64 boundary iteration that must stop instead
# of overflowing, and structural range equality.
print(range(5))
print(range(3, 5))
print(range(5, 0, -2))
print(range(5, 5))
print(range(0, 5, 2))
print(range(5, 0, 2))
print(range(0, -5, -1))
print(range(3) == range(0, 3, 1))
print(range(3) == range(3, 5))
print(range(3) != range(3, 4))

# Descending iteration, stop is exclusive for step < 0 too.
for i in range(5, 0, -2):
    print("desc", i)
n = 0
for i in range(5, 0, 2):
    n = n + 1
print("empty range iterations", n)

# Membership uses exact arithmetic (SPEC §6.9).
print(5 in range(5, 6))
print(6 in range(5, 6))
print(0 in range(3, 0, -1))
print(-1 in range(3, 0, -1))

# Empty range: the loop variable is never bound, so the §9.3 guard must
# fire on a later read (loop vars leak per §6.6, but only their last
# binding — there is none here).
for k in range(3, 3):
    print("bad loop body")
try:
    print(k)
except NameError as e:
    print("empty range loop var:", e.message)

# int64 boundaries: the next index leaving int64 range ends iteration.
for i in range(9223372036854775806, 9223372036854775807):
    print("near max", i)
for i in range(9223372036854775805, 9223372036854775807, 5):
    print("overshoot max", i)
minint = -9223372036854775807 - 1
for i in range(minint + 2, minint, -1):
    print("near min", i)
print(minint in range(minint, minint + 3))
print("done")