# bi_py_stub — the always-fail stubs (SPEC §5.11.6): recognized, reserved,
# arguments evaluate normally, then the call raises RuntimeError with its
# own reason. None of these concepts exist in cstar.
f():
    return 1

try:
    super()
except RuntimeError as e:
    print("1", e.message)
try:
    property(1)
except RuntimeError as e:
    print("2", e.message)
try:
    classmethod(f)
except RuntimeError as e:
    print("3", e.message)
try:
    staticmethod(f)
except RuntimeError as e:
    print("4", e.message)
try:
    issubclass(5, 5)
except RuntimeError as e:
    print("5", e.message)
try:
    breakpoint()
except RuntimeError as e:
    print("6", e.message)
try:
    help()
except RuntimeError as e:
    print("7", e.message)
try:
    memoryview(b"x")
except RuntimeError as e:
    print("8", e.message)
try:
    object()
except RuntimeError as e:
    print("9", e.message)
print("10 done")
